# Copy to .env for local docker-compose (do NOT commit .env)

MYSQL_ROOT_PASSWORD=root_pass_change_me
MYSQL_DATABASE=evidence_db
MYSQL_USER=evidence
MYSQL_PASSWORD=evidence_pass
MYSQL_PORT=3306

API_PORT=3000
NODE_ENV=development
JWT_SECRET=dev-change-me-to-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
# Android emulator from host machine uses localhost; emulator uses 10.0.2.2
PUBLIC_BASE_URL=http://localhost:3000
MAX_UPLOAD_MB=5
